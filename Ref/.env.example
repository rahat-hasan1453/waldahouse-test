# Copy to .env.local and fill in for your machine. Never commit .env.local.

# Postgres connection for enquiries, newsletter sign-ups and the staff page.
# Pages render without it; submitting the forms needs it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: key required to open /admin (leave empty in local development).
ADMIN_KEY=

# Reservation service toggle:
# When false (default), the reservation form runs in mock mode (submits successfully to the user without sending emails).
# Set to true when you are ready to activate real email dispatch and persistence.
ENABLE_RESERVATION_SERVICE=false
