# Dependencies: reinstall with `npm install` (in Ref/ or site/)
node_modules/

# Next.js build output and caches: regenerated by `npm run dev` / `npm run build`
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Local environment: each machine keeps its own (see Ref/.env.example)
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Hosting / tooling caches
.vercel/
coverage/

# macOS / editors
.DS_Store
.idea/
*.swp
